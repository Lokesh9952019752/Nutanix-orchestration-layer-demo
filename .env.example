# Local demo credentials only. Replace all defaults outside demos.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
SESSION_SECRET=replace-with-a-long-random-secret

# Keep true unless your lab Prism portals use private certificates and you accept that risk.
PRISM_VERIFY_SSL=true

PRISM_ONPREM_URL=https://onprem-prism-central.example.com
PRISM_ONPREM_USERNAME=placeholder-user
PRISM_ONPREM_PASSWORD=placeholder-password

PRISM_NC2_AWS_URL=https://nc2-aws-prism-central.example.com
PRISM_NC2_AWS_USERNAME=placeholder-user
PRISM_NC2_AWS_PASSWORD=placeholder-password
